/* pages/settings/settings.wxss */

.container   { background: transparent; min-height: 100vh; padding-bottom: 100rpx; }

/* 分组 */
.setting-group { margin: 0 36rpx 28rpx; background: rgba(255,255,255,0.96); border: 1rpx solid var(--pine-border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-card); }
.group-title   { display: block; font-size: 24rpx; color: var(--text-muted); letter-spacing: 3rpx; font-weight: 800; padding: 32rpx 32rpx 16rpx; border-bottom: 1rpx solid rgba(47,133,90,0.06); }

/* 行 */
.setting-row   { display: flex; align-items: center; padding: 32rpx; border-bottom: 1rpx solid rgba(47,133,90,0.06); }
.setting-row:last-child { border-bottom: none; }
.setting-row:active { background: rgba(61, 107, 87, 0.04); }
.row-icon      { font-size: 44rpx; margin-right: 22rpx; flex-shrink: 0; }
.row-main      { flex: 1; }
.row-label     { font-size: 32rpx; color: var(--text); display: block; font-weight: 700; }
.row-label-amber { font-size: 32rpx; color: var(--amber); font-weight: 700; }
.row-sub       { font-size: 26rpx; color: var(--text-dim); display: block; margin-top: 8rpx; }
.row-sub-green { color: var(--green); }
.row-arrow     { font-size: 36rpx; color: #8a9e92; }
.add-row       { background: var(--amber-pale); }

/* ── 紧急联系人模块 ─────────────────── */
.contact-header {
  display: flex; align-items: center; gap: 12rpx;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid rgba(47,133,90,0.06);
}
.contact-header-icon { font-size: 40rpx; }
.contact-header-title { font-size: 32rpx; font-weight: 900; color: var(--pine-ink); flex: 1; }
.contact-header-count {
  font-size: 24rpx; color: #38a169; font-weight: 600;
  background: #e6f9ee; padding: 6rpx 18rpx; border-radius: 999rpx;
}

/* 添加按钮 */
.contact-add-btn {
  display: flex; align-items: center; gap: 18rpx;
  margin: 20rpx 24rpx; padding: 28rpx 28rpx;
  border: 2rpx dashed rgba(34,118,77,0.3);
  border-radius: 16rpx; background: rgba(34,118,77,0.04);
}
.contact-add-btn:active { background: rgba(34,118,77,0.1); }
.contact-add-icon-wrap {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--pine); display: flex; align-items: center; justify-content: center;
}
.contact-add-icon { font-size: 36rpx; color: #fff; font-weight: 700; line-height: 1; }
.contact-add-text { font-size: 30rpx; color: var(--pine-dark); font-weight: 800; }

/* 联系人卡片 */
.contact-card {
  margin: 0 24rpx 16rpx; background: #f7faf8;
  border-radius: 16rpx; border: 1rpx solid rgba(47,133,90,0.08);
  overflow: hidden;
}
.contact-card:last-of-type { margin-bottom: 24rpx; }
.contact-card-body {
  display: flex; align-items: center; padding: 28rpx 24rpx; gap: 20rpx;
}
.contact-card-body:active { background: #eef5f0; }

/* 头像 */
.contact-avatar-wrap {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: linear-gradient(135deg, #e6f9ee 0%, #d0ece3 100%);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; border: 2rpx solid rgba(56,161,105,0.15);
}
.contact-avatar { font-size: 44rpx; line-height: 1; }

/* 信息区 */
.contact-info { flex: 1; min-width: 0; }
.contact-name-row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 10rpx; }
.contact-name { font-size: 32rpx; font-weight: 700; color: #0d2b1f; }
.contact-relation-tag {
  font-size: 22rpx; color: #38a169; font-weight: 600;
  background: #e6f9ee; padding: 4rpx 16rpx; border-radius: 999rpx;
  border: 1rpx solid rgba(56,161,105,0.15);
}

/* 电话行 */
.contact-phone-row {
  display: flex; align-items: center; gap: 8rpx;
  padding: 8rpx 16rpx; margin-top: 4rpx;
  background: rgba(59,130,246,0.06); border-radius: 10rpx;
  width: fit-content;
}
.contact-phone-row:active { background: rgba(59,130,246,0.14); }
.contact-phone-icon { font-size: 24rpx; }
.contact-phone { font-size: 28rpx; color: #2563eb; font-weight: 600; letter-spacing: 1rpx; }
.contact-dial-hint { font-size: 20rpx; color: #93c5fd; margin-left: 8rpx; }

/* 编辑箭头 */
.contact-edit-arrow { font-size: 36rpx; color: #8a9e92; flex-shrink: 0; }

/* 空状态 */
.contact-empty {
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 0 40rpx; gap: 12rpx;
}
.contact-empty-icon { font-size: 56rpx; opacity: 0.5; }
.contact-empty-text { font-size: 26rpx; color: #8a9e92; }

/* ── 老人基本信息模块 ─────────────────── */
.elderly-header {
  display: flex; align-items: center; gap: 12rpx;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid rgba(47,133,90,0.06);
}
.elderly-header-icon { font-size: 40rpx; }
.elderly-header-title { font-size: 32rpx; font-weight: 800; color: #0d2b1f; }

/* 信息行 */
.elderly-row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(47,133,90,0.06);
}
.elderly-row:last-child { border-bottom: none; }
.elderly-row:active { background: #f0f7f2; }

/* 图标圆形背景 */
.elderly-row-icon-wrap {
  width: 72rpx; height: 72rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  background: transparent;
}
.elderly-row-icon { font-size: 36rpx; line-height: 1; }
.elderly-row-icon-img {
  width: 80%;
  height: 80%;
  border-radius: 14rpx;
}
.elderly-row-icon-blue,
.elderly-row-icon-purple,
.elderly-row-icon-amber  { background: transparent; }

/* 文字区 */
.elderly-row-main { flex: 1; min-width: 0; }
.elderly-row-label { display: block; font-size: 30rpx; font-weight: 700; color: #0d2b1f; }
.elderly-row-value { display: block; font-size: 26rpx; color: #6b8577; margin-top: 6rpx; }

/* 箭头 */
.elderly-row-arrow { font-size: 36rpx; color: #8a9e92; flex-shrink: 0; }

/* ── 家庭组与设备模块 ─────────────────── */
.family-header {
  display: flex; align-items: center; gap: 12rpx;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid rgba(47,133,90,0.06);
}
.family-header-icon-img {
  width: 40rpx;
  height: 40rpx;
}
.family-header-title { font-size: 32rpx; font-weight: 800; color: #0d2b1f; }

/* 家庭组行 */
.family-row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(47,133,90,0.06);
}
.family-row:last-child { border-bottom: none; }
.family-row:active { background: #f0f7f2; }

/* 图标背景 */
.family-row-icon-wrap {
  width: 72rpx; height: 72rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  background: transparent;
}
.family-row-icon { font-size: 36rpx; line-height: 1; }
.family-row-icon-img {
  width: 80%;
  height: 80%;
  border-radius: 14rpx;
}
.family-row-icon-green,
.family-row-icon-blue  { background: transparent; }

/* 文字区 */
.family-row-main { flex: 1; min-width: 0; }
.family-row-label { display: block; font-size: 30rpx; font-weight: 700; color: #0d2b1f; }
.family-row-value { display: block; font-size: 26rpx; color: #6b8577; margin-top: 6rpx; }
.family-row-hint  { color: #f59e0b; font-weight: 600; }
.family-row-bound { color: #38a169; font-weight: 600; }

/* 设备绑定状态 */
.family-device-status { display: flex; align-items: center; gap: 10rpx; margin-top: 6rpx; }
.family-status-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
}
.family-status-dot.dot-bound   { background: #38a169; box-shadow: 0 0 0 4rpx rgba(56,161,105,0.2); }
.family-status-dot.dot-unbound { background: #d1d5db; }

/* 箭头 */
.family-row-arrow { font-size: 36rpx; color: #8a9e92; flex-shrink: 0; }

/* ── 通用模块行（预警设置/今日提醒等） ──── */
.section-header {
  display: flex; align-items: center; gap: 12rpx;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid rgba(47,133,90,0.06);
}
.section-header-icon { font-size: 40rpx; }
.section-header-title { font-size: 32rpx; font-weight: 800; color: #0d2b1f; }

.section-row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(47,133,90,0.06);
}
.section-row:last-child { border-bottom: none; }
.section-row:active { background: #f0f7f2; }

.section-row-icon-wrap {
  width: 72rpx; height: 72rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  background: transparent;
}
.section-row-icon { font-size: 36rpx; line-height: 1; }
.section-row-icon-img {
  width: 80%;
  height: 80%;
  border-radius: 14rpx;
}
.section-icon-indigo,
.section-icon-cyan,
.section-icon-rose   { background: transparent; }

.section-row-main { flex: 1; min-width: 0; }
.section-row-label { display: block; font-size: 30rpx; font-weight: 700; color: #0d2b1f; }
.section-row-value { display: block; font-size: 26rpx; color: #6b8577; margin-top: 6rpx; }
.section-row-arrow { font-size: 36rpx; color: #8a9e92; flex-shrink: 0; }

/* ── 退出登录 ─────────────────── */
.logout-btn {
  display: flex; align-items: center; justify-content: center; gap: 14rpx;
  margin: 0 36rpx 32rpx; padding: 32rpx;
  background: #fff; border: 1rpx solid rgba(239,68,68,0.18);
  border-radius: 20rpx;
}
.logout-btn:active { background: rgba(239,68,68,0.06); }
.logout-btn-icon { font-size: 36rpx; }
.logout-btn-text { font-size: 32rpx; font-weight: 700; color: #dc2626; }

/* ── 关于 ─────────────────── */
.about-footer {
  display: flex; flex-direction: column; align-items: center;
  padding: 40rpx 0 60rpx; gap: 6rpx;
}
.about-logo {
  font-size: 56rpx;
  margin-bottom: 8rpx;
  background: linear-gradient(
    135deg,
    rgba(111, 224, 201, 0.0) 0%,
    rgba(111, 224, 201, 0.42) 45%,
    rgba(26, 160, 124, 0.0) 100%
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  opacity: 1;
  filter: blur(0.15rpx);
}
.about-name { font-size: 28rpx; font-weight: 700; color: #6b8577; }
.about-slogan { font-size: 24rpx; color: #8a9e92; }
