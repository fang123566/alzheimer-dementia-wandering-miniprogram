<!-- pages/login/login.wxml -->
<view class="page">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <!-- 直接使用你提供的山水样式图（纯视觉） -->
    <image
      class="bg-mountain-img"
      src="cloud://cloud1-3gzx0vun034c33f9.636c-cloud1-3gzx0vun034c33f9-1356888498/assets/login-mountains.png"
      mode="aspectFill"
    ></image>

    <!-- 过渡遮罩，让图片和页面背景更自然融合 -->
    <view class="bg-blend-top"></view>
    <view class="bg-blend-bottom"></view>
    <view class="bg-blend-side bg-blend-left"></view>
    <view class="bg-blend-side bg-blend-right"></view>

    <!-- 主山峦层 -->
    <view class="mountain-wave-1"></view>
    <view class="mountain-wave-2"></view>
    <view class="mountain-wave-3"></view>
    <!-- 近山金线描边（纯装饰，不影响交互逻辑） -->
    <view class="mountain-gold-edge"></view>
    <!-- 起伏曲线层 -->
    <view class="mountain-curve-1"></view>
    <view class="mountain-curve-2"></view>
    <view class="mountain-curve-3"></view>
    <!-- 颗粒噪点层 -->
    <view class="mountain-grain"></view>
  </view>

  <!-- 顶部品牌区 -->
  <view class="brand">
    <view class="brand-icon">🛡️</view>
    <text class="brand-name">守护·陪伴</text>
    <text class="brand-slogan">关爱老人，科技守护</text>
  </view>

  <!-- 模式切换：登录 / 注册 -->
  <view class="mode-switch">
    <view
      class="mode-btn {{mode === 'login' ? 'active' : ''}}"
      bindtap="setMode" data-m="login"
    >登录</view>
    <view
      class="mode-btn {{mode === 'register' ? 'active' : ''}}"
      bindtap="setMode" data-m="register"
    >注册</view>
  </view>

<!-- 表单卡片 -->
<view class="form-card {{mode === 'login' && showPhoneDropdown ? 'form-card-dropdown-open' : ''}}">

  <!-- 姓名（仅注册） -->
  <view class="field" wx:if="{{mode === 'register'}}">
    <text class="field-label">姓名</text>
    <input
      class="field-input"
      type="text"
      placeholder="请输入真实姓名"
      placeholder-class="ph"
      value="{{form.name}}"
      bindinput="onInput"
      data-key="name"
      maxlength="10"
    />
  </view>

  <!-- 手机号（登录：右侧 ▼ 展开已登录过的号码） -->
  <view class="field field-phone-field">
    <text class="field-label">手机号</text>
    <view class="field-phone-combo" wx:if="{{mode === 'login'}}">
      <input
        class="field-input field-input-phone-login"
        type="number"
        placeholder="请输入手机号"
        placeholder-class="ph"
        value="{{form.phone}}"
        bindinput="onInput"
        data-key="phone"
        maxlength="11"
      />
      <view
        class="phone-dropdown-trigger"
        wx:if="{{savedPhones.length > 0}}"
        catchtap="togglePhoneDropdown"
      >
        <text class="phone-dropdown-arrow {{showPhoneDropdown ? 'is-open' : ''}}">▼</text>
      </view>
      <view class="phone-dropdown-panel" wx:if="{{showPhoneDropdown && savedPhones.length > 0}}">
        <scroll-view scroll-y class="phone-dropdown-scroll">
          <view class="phone-dropdown-item" wx:for="{{savedPhones}}" wx:key="phone">
            <view
              class="phone-dropdown-item-main"
              catchtap="onPickSavedPhone"
              data-phone="{{item.phone}}"
            >
              <text class="phone-dropdown-num">{{item.phone}}</text>
              <text class="phone-dropdown-nick" wx:if="{{item.nickname}}">{{item.nickname}}</text>
            </view>
            <text
              class="phone-dropdown-remove"
              catchtap="onRemoveSavedPhone"
              data-phone="{{item.phone}}"
            >X</text>
          </view>
        </scroll-view>
      </view>
    </view>
    <input
      wx:else
      class="field-input"
      type="number"
      placeholder="请输入手机号"
      placeholder-class="ph"
      value="{{form.phone}}"
      bindinput="onInput"
      data-key="phone"
      maxlength="11"
    />
  </view>

  <!-- 密码 -->
  <view class="field">
    <text class="field-label">密码</text>
    <input
      class="field-input"
      password
      placeholder="{{mode === 'register' ? '请设置密码（6位以上）' : '请输入密码'}}"
      placeholder-class="ph"
      value="{{form.password}}"
      bindinput="onInput" data-key="password"
      maxlength="20"
    />
  </view>

  <!-- 角色选择（仅注册） -->
  <view wx:if="{{mode === 'register'}}">
    <text class="role-title">选择身份</text>
    <view class="role-grid">
      <view
        class="role-card {{form.role === 'family' ? 'role-active-family' : ''}}"
        bindtap="selectRole" data-role="family"
      >
        <image
          class="role-icon"
          src="cloud://cloud1-3gzx0vun034c33f9.636c-cloud1-3gzx0vun034c33f9-1356888498/assets/家属端.png"
          mode="aspectFill"
        />
        <text class="role-name">家属端</text>
        <text class="role-desc">查看轨迹、接收预警、管理记忆</text>
        <view class="role-check" wx:if="{{form.role === 'family'}}">✓</view>
      </view>
      <view
        class="role-card {{form.role === 'elderly' ? 'role-active-elderly' : ''}}"
        bindtap="selectRole" data-role="elderly"
      >
        <image
          class="role-icon"
          src="cloud://cloud1-3gzx0vun034c33f9.636c-cloud1-3gzx0vun034c33f9-1356888498/assets/老人端.png"
          mode="aspectFill"
        />
        <text class="role-name">老人端</text>
        <text class="role-desc">SOS求助、AI伴聊、简洁模式</text>
        <view class="role-check" wx:if="{{form.role === 'elderly'}}">✓</view>
      </view>
    </view>
  </view>

  <!-- 错误提示 -->
  <view class="error-tip" wx:if="{{errorMsg}}">
    <text class="error-text">⚠️ {{errorMsg}}</text>
  </view>

  <!-- 提交按钮 -->
  <view
    class="submit-btn {{loading ? 'disabled' : ''}}"
    bindtap="submit"
  >
    <text wx:if="{{!loading}}">{{mode === 'login' ? '登 录' : '注 册'}}</text>
    <text wx:else>处理中…</text>
  </view>

  <!-- 切换提示 -->
  <view class="switch-tip">
    <text wx:if="{{mode === 'login'}}">还没有账号？</text>
    <text wx:else>已有账号？</text>
    <text
      class="switch-link"
      bindtap="setMode"
      data-m="{{mode === 'login' ? 'register' : 'login'}}"
    >{{mode === 'login' ? '立即注册' : '去登录'}}</text>
  </view>

</view>

  <view
    class="phone-dropdown-backdrop"
    wx:if="{{mode === 'login' && showPhoneDropdown}}"
    catchtap="closePhoneDropdown"
    catchtouchmove="noop"
  ></view>

</view>
