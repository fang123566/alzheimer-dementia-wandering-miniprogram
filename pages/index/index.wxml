<!-- pages/index/index.wxml · 常青树适老化服务平台 · 新中式首页 -->

<view class="home-page {{role === 'elderly' ? 'home-page--elder' : ''}} {{elderlyComfort ? 'home-page--comfort' : ''}}">
  <view class="home-status" style="height: {{statusBarHeight}}px;"></view>

  <!-- 1. 顶部导航：定位 | 搜索 | 入口 -->
  <view class="home-nav">
    <view class="home-nav-loc" bindtap="onLocationPickerTap" hover-class="home-tap">
      <text class="home-nav-loc-text">{{shortLocation}}</text>
      <text class="home-nav-chev">⌄</text>
    </view>
    <view class="home-search" bindtap="onSearchTap" hover-class="home-tap">
      <text class="home-search-ph">搜索服务、提醒与功能</text>
    </view>
    <view class="home-nav-entry" bindtap="onMoreMenuTap" hover-class="home-tap">
      <text class="home-entry-dots">···</text>
      <view class="home-entry-dot"></view>
    </view>
  </view>

  <!-- 2. Banner：国风水墨底图 + 书法标题 -->
  <view class="home-banner">
    <image class="home-banner-img" src="../../assets/login-mountains.png" mode="aspectFill" />
    <view class="home-banner-veil"></view>
    <view class="home-banner-inner">
      <text class="home-banner-title font-calligraphy">常青树适老化服务平台</text>
      <text class="home-banner-sub">{{greeting}}，{{userInfo.name || '用户'}} · {{role === 'elderly' ? '老人端' : '家属端'}}</text>
    </view>
  </view>

  <!-- ══════════ 家属端 ══════════ -->
  <view class="home-body" wx:if="{{role === 'family'}}">
    <text class="home-section-title font-calligraphy">便民入口</text>
    <view class="home-func-grid">
      <view
        wx:for="{{familyFuncs}}"
        wx:key="action"
        class="home-func-cell"
        bindtap="onFuncTap"
        data-action="{{item.action}}"
        hover-class="home-cell-active"
      >
        <view class="home-func-icon">
          <image class="home-func-img" src="{{item.iconImage}}" mode="aspectFill" />
        </view>
        <text class="home-func-label">{{item.name}}</text>
      </view>
    </view>

    <view class="gj-card status-card status-card-{{statusLevel}}">
      <view class="card-title-row">
        <text class="card-title">实时守护</text>
        <view class="fence-switch" bindtap="toggleFence">
          <view class="fence-track {{fenceEnabled ? 'on' : ''}}">
            <view class="fence-thumb"></view>
          </view>
          <text class="fence-label">围栏{{fenceEnabled ? '开' : '关'}}</text>
        </view>
      </view>
      <view class="status-tag-row" bindtap="toggleAddressExpand">
        <view class="status-tag status-tag-{{statusLevel}}">
          <text class="status-tag-text">{{statusText}}</text>
        </view>
        <text class="expand-arrow">{{addressExpanded ? '⌃' : '⌄'}}</text>
      </view>
      <view class="address-detail {{addressExpanded ? 'show' : ''}}">
        <text class="location-address">{{currentLocation.address || '正在获取位置…'}}</text>
      </view>
      <view class="freshness-row">
        <text class="freshness-text {{freshnessStale ? 'stale' : ''}}">{{freshnessText}}</text>
      </view>
      <view class="gj-btn-ghost" bindtap="goLocation">查看轨迹与地图</view>
    </view>

    <view class="stat-grid">
      <view class="stat-card stat-card-clickable" bindtap="goLocation">
        <text class="stat-label">{{distanceLabel}}</text>
        <text class="stat-value stat-value-distance">{{distanceText}}</text>
      </view>
      <view class="stat-card stat-card-clickable {{alertsHot ? 'stat-card-hot' : ''}}" bindtap="goAlert">
        <view wx:if="{{alertsHot}}" class="stat-red-dot"></view>
        <text class="stat-label">今日预警</text>
        <text class="stat-value {{alertsHot ? 'val-danger' : 'val-muted'}}">{{alertsText}}</text>
      </view>
      <view class="stat-card stat-card-clickable" bindtap="goChat">
        <text class="stat-label">AI 关怀</text>
        <text class="stat-value">{{stats.aiChats}} 次</text>
      </view>
    </view>

    <view class="gj-card">
      <view class="card-title-row">
        <text class="card-title">最近预警</text>
        <text class="link-text" bindtap="goAlert">全部</text>
      </view>
      <view wx:for="{{recentAlerts}}" wx:key="id" class="alert-row">
        <view class="alert-dot {{item.level}}"></view>
        <view class="alert-info">
          <text class="alert-title">{{item.title}}</text>
          <text class="alert-time">{{item.time}}</text>
        </view>
      </view>
      <view wx:if="{{recentAlerts.length === 0}}" class="empty-tip">暂无预警，一切如常</view>
    </view>
  </view>

  <!-- ══════════ 老人端 ══════════ -->
  <view class="home-body home-body-elder" wx:else>
    <text class="home-section-title font-calligraphy e-date-line">{{currentDate}}</text>

    <view class="e-sos-card gj-sos" bindlongpress="triggerSOS" bindtap="triggerSOSTap" hover-class="home-cell-active">
      <view class="e-sos-inner">
        <text class="e-sos-label">紧急求助</text>
        <text class="e-sos-hint">长按约 3 秒向家人发送位置</text>
      </view>
    </view>

    <text class="home-section-title font-calligraphy">常用功能</text>
    <view class="home-func-grid home-func-grid-elder">
      <view class="home-func-cell" bindtap="callEmergency" hover-class="home-cell-active">
        <view class="home-func-icon tone-gold">
          <image class="home-func-img" src="cloud://cloud1-3gzx0vun034c33f9.636c-cloud1-3gzx0vun034c33f9-1356888498/assets/联系家人.png" mode="aspectFill" />
        </view>
        <text class="home-func-label">联系家人</text>
      </view>
      <view class="home-func-cell" bindtap="goChat" hover-class="home-cell-active">
        <view class="home-func-icon tone-pine">
          <image class="home-func-img" src="cloud://cloud1-3gzx0vun034c33f9.636c-cloud1-3gzx0vun034c33f9-1356888498/assets/AI陪聊.png" mode="aspectFill" />
        </view>
        <text class="home-func-label">AI 陪聊</text>
      </view>
      <view class="home-func-cell" bindtap="goDialect" hover-class="home-cell-active">
        <view class="home-func-icon tone-ink">
          <image class="home-func-img" src="cloud://cloud1-3gzx0vun034c33f9.636c-cloud1-3gzx0vun034c33f9-1356888498/assets/方言助手.png" mode="aspectFill" />
        </view>
        <text class="home-func-label">方言助手</text>
      </view>
      <view class="home-func-cell" bindtap="goMemory" hover-class="home-cell-active">
        <view class="home-func-icon tone-mist">
          <image class="home-func-img" src="cloud://cloud1-3gzx0vun034c33f9.636c-cloud1-3gzx0vun034c33f9-1356888498/assets/记忆相册.png" mode="aspectFill" />
        </view>
        <text class="home-func-label">记忆相册</text>
      </view>
    </view>

    <view class="gj-card e-location-card">
      <view class="e-loc-row">
        <view class="e-loc-info">
          <text class="e-loc-addr">{{currentLocation.address || '正在获取位置…'}}</text>
          <text class="e-loc-status">状态：{{statusText}}</text>
        </view>
        <view class="tag {{statusTag}}">{{statusText}}</view>
      </view>
      <view class="e-loc-refresh-btn {{locating ? 'disabled' : ''}}" bindtap="refreshLocation">
        <text class="e-loc-refresh-text">{{locating ? '更新中…' : '重新定位'}}</text>
      </view>
    </view>

    <view class="e-device-row">
      <view class="e-device-item">
        <text class="e-device-text">今日预警 {{stats.alerts}} 次</text>
      </view>
    </view>
  </view>

  <view class="tab-bar-spacer"></view>
</view>
