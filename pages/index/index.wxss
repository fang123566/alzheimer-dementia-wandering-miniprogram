/* pages/index/index.wxss · 新中式轻国风 · 松绿主色（变量来自 app.wxss） */

.home-page {
  min-height: 100vh;
  /* 底部仅依赖 wxml 中 tab-bar-spacer，避免与 padding-bottom 叠加倍增高 */
  padding-bottom: 0;
  background: var(--app-bg);
  font-family: -apple-system, 'PingFang SC', 'Noto Sans SC', 'Hiragino Sans GB', sans-serif;
  color: var(--pine-ink);
  box-sizing: border-box;
}

/* 老人端：首页字号再放大一档 */
.home-page--elder {
  --home-banner-title: 54rpx;
  --home-banner-sub: 36rpx;
  --home-nav-text: 32rpx;
  --home-search-text: 34rpx;
  --home-section-title: 40rpx;
  --home-func-label: 32rpx;
  --home-func-glyph: 50rpx;
  --home-card-title: 36rpx;
  --home-stat-label: 28rpx;
  --home-stat-value: 34rpx;
  --home-sos-label: 56rpx;
  --home-sos-hint: 32rpx;
  --home-e-loc-addr: 36rpx;
  --home-e-device: 34rpx;
}

/* 大字号舒适模式（家属端也可开启） */
.home-page--comfort {
  --home-banner-title: 48rpx;
  --home-banner-sub: 32rpx;
  --home-nav-text: 30rpx;
  --home-search-text: 32rpx;
  --home-section-title: 36rpx;
  --home-func-label: 28rpx;
  --home-func-glyph: 46rpx;
  --home-card-title: 32rpx;
}

.home-page--elder.home-page--comfort {
  --home-banner-title: 56rpx;
  --home-banner-sub: 38rpx;
  --home-sos-label: 58rpx;
}

.font-calligraphy {
  font-family: 'STKaiti', 'KaiTi', 'Songti SC', 'SimSun', serif;
  letter-spacing: 0.12em;
}

.home-status {
  width: 100%;
}

/* ── 顶部导航 ── */
.home-nav {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 28rpx 20rpx;
}

.home-nav-loc {
  min-width: 96rpx;
  min-height: 88rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid var(--pine-border-12);
  border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx var(--pine-shadow);
}

.home-nav-loc-text {
  max-width: 140rpx;
  font-size: var(--home-nav-text);
  font-weight: 700;
  color: var(--pine);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-nav-chev {
  font-size: 22rpx;
  color: var(--pine-alpha-65);
  line-height: 1;
}

.home-search {
  flex: 1;
  min-height: 88rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid var(--pine-border);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx var(--pine-shadow);
}

.home-search-ph {
  font-size: var(--home-search-text);
  color: #9a9a94;
}

.home-nav-entry {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid var(--pine-border-12);
  border-radius: 28rpx;
  box-shadow: 0 6rpx 20rpx var(--pine-shadow);
}

.home-entry-dots {
  font-size: var(--home-nav-text);
  line-height: 1;
  color: var(--pine);
  letter-spacing: 2rpx;
  font-weight: 700;
}

.home-entry-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--gold), var(--gold-soft));
  box-shadow: 0 2rpx 8rpx var(--gold-pale);
}

.home-tap {
  opacity: 0.92;
}

/* ── Banner ── */
.home-banner {
  position: relative;
  margin: 0 28rpx 28rpx;
  height: 280rpx;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx var(--pine-shadow);
}

.home-banner-img {
  width: 100%;
  height: 100%;
  display: block;
}

.home-banner-veil {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(
    120deg,
    rgba(250, 248, 244, 0.55) 0%,
    var(--pine-pale-18) 45%,
    rgba(250, 248, 244, 0.35) 100%
  );
}

.home-banner-inner {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx 36rpx;
}

.home-banner-title {
  display: block;
  font-size: var(--home-banner-title);
  font-weight: 700;
  color: var(--pine-dark);
  text-shadow: 0 2rpx 16rpx rgba(255, 255, 255, 0.85);
  line-height: 1.45;
}

.home-banner-sub {
  display: block;
  margin-top: 12rpx;
  font-size: var(--home-banner-sub);
  color: rgba(44, 61, 53, 0.72);
  font-weight: 500;
}

/* ── 正文区 ── */
.home-body {
  padding: 0 28rpx;
}

.home-section-title {
  display: block;
  font-size: var(--home-section-title);
  color: var(--pine);
  margin: 36rpx 0 24rpx;
  font-weight: 700;
}

.home-body-elder .home-section-title:first-of-type {
  margin-top: 8rpx;
}

.e-date-line {
  margin-top: 0;
  margin-bottom: 20rpx;
  font-size: var(--home-banner-sub);
  color: var(--text-muted);
  letter-spacing: 0.08em;
}

/* ── 功能宫格 4×2 ── */
.home-func-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx 16rpx;
  margin-bottom: 8rpx;
}

.home-func-grid-elder {
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.home-func-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 160rpx;
  padding: 20rpx 8rpx;
  box-sizing: border-box;
}

.home-func-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: none;
  margin-bottom: 14rpx;
  background: transparent;
  overflow: hidden;
}

.home-func-img {
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.home-func-label {
  font-size: var(--home-func-label);
  color: #4a5c54;
  font-weight: 600;
  text-align: center;
  line-height: 1.35;
}

.tone-pine {
  background: linear-gradient(160deg, var(--pine-14) 0%, rgba(255, 255, 255, 0.95) 100%);
}
.tone-gold {
  background: linear-gradient(160deg, rgba(201, 169, 98, 0.22) 0%, rgba(255, 255, 255, 0.95) 100%);
}
.tone-ink {
  background: linear-gradient(160deg, rgba(90, 110, 100, 0.12) 0%, rgba(255, 255, 255, 0.96) 100%);
}
.tone-mist {
  background: linear-gradient(160deg, rgba(180, 190, 184, 0.2) 0%, rgba(255, 255, 255, 0.96) 100%);
}
.tone-coral {
  background: linear-gradient(160deg, rgba(229, 152, 102, 0.18) 0%, rgba(255, 255, 255, 0.96) 100%);
}

.home-cell-active {
  opacity: 0.88;
  transform: scale(0.98);
}

/* ── 国风卡片（原 card） ── */
.gj-card {
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid var(--pine-border);
  border-radius: 36rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 40rpx var(--pine-shadow);
}

.status-card {
  border-left: 6rpx solid var(--pine);
}

.status-card-safe {
  border-left-color: var(--pine-soft);
}

.status-card-warning {
  border-left-color: var(--warm-amber);
}

.status-card-danger {
  border-left-color: var(--warm-coral);
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: var(--home-card-title);
  font-weight: 800;
  color: var(--pine-ink);
}

.link-text {
  font-size: var(--font-lg);
  color: var(--pine);
  font-weight: 700;
}

.gj-btn-ghost {
  margin-top: 24rpx;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--pine);
  background: var(--pine-pale);
  border: 1rpx solid var(--pine-pale-12);
}

/* 状态标签 */
.status-tag-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.status-tag-text {
  font-size: var(--font-base);
}

.status-tag-safe {
  background: var(--pine-pale-12);
  color: var(--pine);
}

.status-tag-warning {
  background: rgba(212, 165, 116, 0.22);
  color: #8a5f3a;
}

.status-tag-danger {
  background: rgba(229, 152, 102, 0.2);
  color: #a65f3a;
}

.expand-arrow {
  font-size: 24rpx;
  color: #9aa8a0;
  padding: 8rpx 12rpx;
}

.address-detail {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, padding 0.3s ease;
  padding: 0 4rpx;
}

.address-detail.show {
  max-height: 240rpx;
  padding: 16rpx 4rpx;
}

.location-address {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--pine-ink);
  line-height: 1.6;
}

.freshness-row {
  margin-top: 12rpx;
}

.freshness-text {
  font-size: var(--font-base);
  color: var(--text-muted);
  font-weight: 500;
}

.freshness-text.stale {
  color: #c17a4a;
  font-weight: 700;
}

/* 围栏开关 */
.fence-switch {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.fence-track {
  position: relative;
  width: 72rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: #d8d5cf;
  transition: background 0.25s;
}

.fence-track.on {
  background: var(--pine-soft);
}

.fence-thumb {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
  transition: left 0.25s;
}

.fence-track.on .fence-thumb {
  left: 36rpx;
}

.fence-label {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 600;
}

/* 统计三格 */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.stat-card {
  position: relative;
  min-height: 168rpx;
  padding: 28rpx 12rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid var(--pine-pale);
  box-shadow: 0 10rpx 28rpx var(--pine-shadow);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.stat-card-clickable:active {
  opacity: 0.9;
}

.stat-card-hot {
  border-color: rgba(229, 152, 102, 0.35);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 248, 240, 0.9) 100%);
}

.stat-red-dot {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--warm-coral);
}

.stat-label {
  font-size: var(--home-stat-label);
  color: var(--text-muted);
  margin-bottom: 8rpx;
  font-weight: 600;
  text-align: center;
}

.stat-value {
  font-size: var(--home-stat-value);
  font-weight: 800;
  color: var(--pine-ink);
  text-align: center;
}

.stat-value-distance {
  font-size: var(--home-stat-value);
}

.val-danger {
  color: #c17a4a;
}

.val-muted {
  color: #9aa8a0;
}

/* 预警列表 */
.alert-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--pine-pale);
}

.alert-row:last-child {
  border-bottom: none;
}

.alert-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.alert-dot.warning {
  background: #d4a574;
}

.alert-dot.danger {
  background: #e59866;
}

.alert-info {
  flex: 1;
}

.alert-title {
  font-size: var(--font-lg);
  color: var(--pine-ink);
  font-weight: 700;
}

.alert-time {
  font-size: var(--font-base);
  color: var(--text-muted);
  margin-top: 6rpx;
}

.empty-tip {
  text-align: center;
  font-size: var(--font-lg);
  color: var(--text-muted);
  padding: 36rpx 0;
}

/* ── 老人端 SOS ── */
.gj-sos {
  border: 2rpx solid rgba(229, 152, 102, 0.35);
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 246, 238, 0.95) 100%);
  margin-bottom: 12rpx;
}

.e-sos-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 36rpx 20rpx;
}

.e-sos-label {
  font-size: var(--home-sos-label);
  font-weight: 900;
  color: #c17a4a;
  letter-spacing: 0.2em;
  font-family: 'STKaiti', 'KaiTi', 'Songti SC', serif;
}

.e-sos-hint {
  font-size: var(--home-sos-hint);
  color: var(--text-muted);
}

.e-location-card .e-loc-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.e-loc-info {
  flex: 1;
}

.e-loc-addr {
  display: block;
  font-size: var(--home-e-loc-addr);
  color: var(--pine-ink);
  font-weight: 700;
  line-height: 1.5;
}

.e-loc-status {
  display: block;
  font-size: var(--home-banner-sub);
  color: var(--text-muted);
  margin-top: 8rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.tag-safe {
  background: var(--pine-pale-12);
  color: var(--pine);
}

.tag-warning {
  background: rgba(212, 165, 116, 0.22);
  color: #8a5f3a;
}

.tag-danger {
  background: rgba(229, 152, 102, 0.2);
  color: #a65f3a;
}

.e-loc-refresh-btn {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  background: linear-gradient(135deg, var(--pine) 0%, var(--pine-light) 100%);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 28rpx var(--pine-22);
}

.e-loc-refresh-btn.disabled {
  opacity: 0.55;
}

.e-loc-refresh-text {
  font-size: var(--font-lg);
  color: var(--cream);
  font-weight: 700;
}

.e-device-row {
  display: flex;
  margin-bottom: 12rpx;
}

.e-device-item {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid var(--pine-border);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx var(--pine-shadow);
}

.e-device-text {
  font-size: var(--home-e-device);
  color: #4a5c54;
  font-weight: 600;
}

/* 家属端：最后一卡与 tab 占位之间略收紧，减少见底时空旷感 */
.home-page .home-body:not(.home-body-elder) > .gj-card:last-child {
  margin-bottom: 12rpx;
}
