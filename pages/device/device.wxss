/* pages/device/device.wxss */

/* ─── 全局 ─────────────────────────────────── */
page {
  background: transparent;
  font-family: -apple-system, 'PingFang SC', 'Noto Sans SC', sans-serif;
  box-sizing: border-box;
}

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* ─── 顶部 Header ───────────────────────────── */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 20rpx;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(18rpx);
  border-bottom: 1rpx solid rgba(47,133,90,0.08);
  box-shadow: 0 10rpx 30rpx rgba(44,61,53,0.06);
  position: sticky;
  top: 0;
  z-index: 100;
}

.app-title {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--pine-dark);
  letter-spacing: 1rpx;
}

.status-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 24rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: background-color 0.3s ease, color 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
}

.status-pill.status-idle,
.status-pill.status-disconnected {
  background: rgba(44,61,53,0.06);
  color: var(--text-dim);
}
.status-pill.status-scanning {
  background: var(--amber-pale);
  color: #8a5f3a;
}
.status-pill.status-connecting {
  background: rgba(47,158,132,0.12);
  color: var(--teal);
}
.status-pill.status-connected {
  background: var(--green-pale);
  color: var(--green);
}

.status-icon { font-size: 20rpx; }
.status-text { font-size: 24rpx; }

/* ─── 控制栏 ───────────────────────────────── */
.control-bar {
  padding: 24rpx 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ctrl-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  letter-spacing: 2rpx;
}

.ctrl-btn.primary  { background: linear-gradient(135deg, var(--pine-dark), var(--pine-light)); color: #fff; box-shadow: 0 12rpx 28rpx var(--pine-pale-18); }
.ctrl-btn.secondary { background: rgba(255,255,255,0.9); color: var(--pine-ink); border: 1rpx solid var(--pine-border-12); box-shadow: var(--shadow-soft); }
.ctrl-btn.danger   { background: rgba(239,68,68,0.08); color: #b91c1c; border: 1rpx solid rgba(239,68,68,0.18); }
.ctrl-btn:active { transform: scale(var(--press-scale)); opacity: var(--press-opacity); }

.ctrl-btn::after { border: none; }

/* 扫描动画提示 */
.scanning-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 8rpx 0;
}
.scanning-dot {
  font-size: 18rpx;
  color: var(--pine);
  animation: blink 1.2s infinite;
}
.scanning-dot:nth-child(2) { animation-delay: 0.4s; }
.scanning-dot:nth-child(3) { animation-delay: 0.8s; }
.scanning-label { font-size: 24rpx; color: #888; }
.scanning-label { font-size: 24rpx; color: var(--text-muted); }

@keyframes blink {
  0%, 100% { opacity: 0.2; }
  50% { opacity: 1; }
}

/* ─── 设备列表 ─────────────────────────────── */
.device-list {
  margin: 0 32rpx 16rpx;
}

.section-label {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}

.device-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(255,255,255,0.96);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(47,133,90,0.08);
  box-shadow: var(--shadow-soft);
  transition: transform 0.1s;
}
.device-card:active { transform: scale(0.98); }

.device-icon { font-size: 48rpx; }
.device-info { flex: 1; min-width: 0; }
.device-name { font-size: 28rpx; font-weight: 600; color: #1a1a2e; display: block; }
.device-name { font-size: 28rpx; font-weight: 800; color: var(--pine-ink); display: block; }
.device-id {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.device-rssi { text-align: right; }
.device-rssi text { display: block; font-size: 22rpx; color: #aaa; }
.device-rssi text { display: block; font-size: 22rpx; color: var(--text-muted); }
.connect-hint { color: var(--pine) !important; font-size: 24rpx !important; font-weight: 700 !important; }

/* ─── 连接中占位 ───────────────────────────── */
.connecting-placeholder {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}
.connecting-text { font-size: 30rpx; color: #888; }
.connecting-text { font-size: 30rpx; color: var(--text-muted); }

/* ─── 空状态 ───────────────────────────────── */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 60rpx;
  gap: 20rpx;
}
.empty-icon { font-size: 120rpx; opacity: 0.4; }
.empty-title { font-size: 34rpx; font-weight: 700; color: #555; }
.empty-desc { font-size: 26rpx; color: #aaa; text-align: center; line-height: 1.6; }

/* ─── 聊天区 ───────────────────────────────── */
.chat-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  /* 留出 input-bar + record-bar 的高度 */
  padding-bottom: 0;
}

.message-list {
  flex: 1;
  height: calc(100vh - 280rpx - env(safe-area-inset-bottom));
  padding: 16rpx 24rpx;
}

.message-bottom-spacer {
  height: 16rpx;
}

/* ─── 消息气泡 ─────────────────────────────── */
.msg-row { margin-bottom: 20rpx; }

/* 信息提示（居中系统消息） */
.msg-info {
  text-align: center;
  padding: 4rpx 0;
}
.msg-info-text {
  font-size: 22rpx;
  color: #aaa;
  background: rgba(0,0,0,0.04);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  display: inline-block;
}

/* 气泡容器 */
.msg-bubble-wrap {
  display: flex;
  flex-direction: column;
  max-width: 72%;
}
.msg-bubble-wrap.right { align-items: flex-end; margin-left: auto; }
.msg-bubble-wrap.left  { align-items: flex-start; }

.msg-bubble {
  padding: 20rpx 28rpx;
  border-radius: 28rpx;
  word-break: break-all;
}

.msg-bubble.sent {
  background: linear-gradient(135deg, var(--pine-dark), var(--pine-light));
  border-bottom-right-radius: 8rpx;
}
.msg-bubble.sent .msg-text { color: #fff; font-size: 28rpx; }

.msg-bubble.received {
  background: rgba(255,255,255,0.96);
  border-bottom-left-radius: 8rpx;
  border: 1rpx solid rgba(47,133,90,0.08);
  box-shadow: var(--shadow-soft);
}
.msg-bubble.received .msg-text { color: var(--pine-ink); font-size: 28rpx; }

/* 音频气泡 */
.msg-bubble.audio {
  background: rgba(255,255,255,0.96);
  border-bottom-left-radius: 8rpx;
  border: 1rpx solid rgba(47,133,90,0.08);
  box-shadow: var(--shadow-soft);
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  min-width: 220rpx;
}
.audio-icon { font-size: 48rpx; }
.audio-title { font-size: 28rpx; color: var(--pine-ink); display: block; font-weight: 800; }
.audio-hint  { font-size: 22rpx; color: var(--text-muted); display: block; margin-top: 4rpx; }
.audio-wave  { font-size: 28rpx; color: var(--pine); margin-left: auto; }

/* 紧急消息 */
.msg-emergency {
  background: linear-gradient(135deg, #ff1744, #d50000);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin: 0 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 23, 68, 0.4);
}
.msg-emergency-text {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: block;
}
.emergency-time { color: rgba(255,255,255,0.7) !important; }

.msg-time {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 8rpx;
  padding: 0 4rpx;
  display: block;
}

/* ─── 输入栏 ───────────────────────────────── */
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 12rpx;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(18rpx);
  border-top: 1rpx solid rgba(47,133,90,0.08);
}

.text-input {
  flex: 1;
  height: 76rpx;
  background: rgba(44,61,53,0.04);
  border-radius: 38rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--pine-ink);
  border: 2rpx solid transparent;
}
.text-input:focus { border-color: var(--pine); }

.send-btn {
  width: 120rpx;
  height: 76rpx;
  background: linear-gradient(135deg, var(--pine-dark), var(--pine-light));
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 38rpx;
  border: none;
  padding: 0;
  flex-shrink: 0;
}
.send-btn[disabled] { background: rgba(44,61,53,0.18); color: rgba(44,61,53,0.55); }
.send-btn::after { border: none; }

/* ─── 录音栏 ───────────────────────────────── */
.record-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(18rpx);
}

.record-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 88rpx;
  padding: 0 48rpx;
  border-radius: 44rpx;
  background: rgba(61,107,87,0.10);
  border: 2rpx solid rgba(61,107,87,0.28);
  color: var(--pine-dark);
  font-size: 28rpx;
  font-weight: 600;
  transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
}
.record-btn.recording {
  background: #ff1744;
  border-color: #ff1744;
  color: #fff;
  animation: pulse 1s infinite;
}
.record-btn::after { border: none; }

.record-icon { font-size: 36rpx; }

@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255,23,68,0.4); }
  50% { box-shadow: 0 0 0 12rpx rgba(255,23,68,0); }
}

.playing-indicator {
  font-size: 26rpx;
  color: var(--pine);
  font-weight: 500;
}
