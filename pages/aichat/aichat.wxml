<!-- pages/aichat/aichat.wxml -->
<!-- AI 伴聊 · 情绪安抚 · 防诈拦截 -->

<view class="page-container {{pageClass}}">
  <!-- 固定顶部区域 -->
  <view class="chat-header">
    <view class="bot-info">
      <view class="bot-avatar">🤖</view>
      <view class="bot-text-wrap">
        <text class="bot-name">小守</text>
        <text class="bot-status">● 我一直在这里陪着你</text>
      </view>
      <view class="header-actions">
        <view class="header-btn {{autoSpeakClass}}" bindtap="toggleAutoSpeak">{{autoSpeakLabel}}</view>
        <view class="header-btn {{elderlyModeClass}}" bindtap="toggleElderlyMode">{{elderlyModeLabel}}</view>
        <view class="header-btn" bindtap="clearHistory">清空</view>
      </view>
    </view>
    <view class="capability-bar">
      <view class="capability-tag" wx:for="{{capabilityTags}}" wx:key="*this">
        <text class="capability-tag-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 滚动聊天区域 -->
  <scroll-view class="chat-content" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation enable-back-to-top>
    <view class="chat-log">
      <view class="welcome-card" wx:if="{{!messages.length}}">
        <text class="welcome-title">您好，我是小守</text>
        <text class="welcome-desc">您可以直接跟我说话，也可以点聊天框上面的快捷按钮。我会陪您聊天，也能帮您处理常见事情。</text>
        <view class="suggestion-list">
          <view class="suggestion-chip" wx:for="{{suggestions}}" wx:key="*this" data-text="{{item}}" bindtap="useSuggestion">{{item}}</view>
        </view>
      </view>

      <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="msg-row {{item.role}}">
        <view class="msg-avatar avatar-bot" wx:if="{{item.isBot}}">🤖</view>

        <view class="msg-body">
          <text class="msg-name">{{item.displayName}}</text>

          <view class="bubble bubble-fraud" wx:if="{{item.isFraudAlert}}">
            <text class="fraud-title">🚨 检测到诈骗话术！</text>
            <text class="bubble-text">{{item.text}}</text>
            <text class="fraud-tip">{{item.tip}}</text>
          </view>

          <view class="bubble bubble-soothe" wx:elif="{{item.isSoothe}}">
            <text class="bubble-text">{{item.text}}</text>
            <text class="soothe-tag">【安抚模式】</text>
          </view>

          <view class="bubble {{item.bubbleClass}}" wx:else>
            <text class="bubble-text">{{item.text}}</text>
            <text class="emotion-note" wx:if="{{item.emotionNote}}">{{item.emotionNote}}</text>
            <text class="message-tip" wx:if="{{item.tip}}">{{item.tip}}</text>
            <!-- 朗读按钮：对应 js 中的 speakMessage 方法 -->
            <view class="speak-btn" wx:if="{{item.canSpeak}}" bindtap="speakMessage" data-text="{{item.text}}">
              🔊 朗读
            </view>
          </view>

          <text class="msg-time">{{item.time}}</text>
        </view>

        <view class="msg-avatar avatar-user" wx:if="{{item.isUser}}">👴</view>
      </view>

      <!-- 底部占位，避免被输入框/键盘遮挡 -->
      <view class="chat-bottom-spacer" style="{{chatBottomSpacerStyle}}"></view>
    </view>
  </scroll-view>

  <!-- 底部固定输入区 -->
  <view class="input-section" style="{{inputSectionStyle}}">
    <!-- 快捷功能栏 -->
    <scroll-view class="quick-strip" scroll-x enhanced show-scrollbar="{{false}}" enable-flex>
      <view class="quick-strip-inner">
        <view class="quick-chip" wx:for="{{quickActions}}" wx:key="id" data-text="{{item.text}}" bindtap="onQuickAction">
          <text class="quick-chip-icon">{{item.icon}}</text>
          <text class="quick-chip-text">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="input-bar">
      <!-- 语音按钮：按住开始录音，松手结束并识别，填入输入框 -->
      <view
        class="voice-btn {{voiceBtnClass}}"
        bindtouchstart="startRecord"
        bindtouchend="stopRecord"
      >
        <text wx:if="{{!isRecording}}">🎙️</text>
        <text wx:else>🔴 {{recordingDuration}}s</text>
      </view>

      <view class="input-wrap">
        <input
          type="text"
          class="text-input"
          placeholder="{{isRecording ? '正在录音…' : '发消息'}}"
          placeholder-class="ph"
          value="{{inputText}}"
          bindinput="onInput"
          confirm-type="send"
          bindconfirm="sendMessage"
          adjust-position="{{true}}"
          hold-keyboard="{{true}}"
          cursor-spacing="20"
        />
      </view>
      <view class="send-btn {{sendBtnClass}}" bindtap="sendMessage">{{sendBtnText}}</view>
    </view>
  </view>
</view>
