<view class="container">

  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">⏰ 今日提醒管理</text>
    <text class="page-subtitle">新增 · 编辑 · 删除 · 自动提醒</text>
  </view>

  <!-- 操作栏 -->
  <view class="action-bar">
    <view class="action-btn" bindtap="addTemplate">
      <text class="action-icon">＋</text>
      <text class="action-text">新增</text>
    </view>
    <view class="action-btn {{mode === 'edit' ? 'active' : ''}}" bindtap="switchMode" data-mode="edit">
      <text class="action-icon">✏️</text>
      <text class="action-text">编辑</text>
    </view>
    <view class="action-btn {{mode === 'delete' ? 'active' : ''}}" bindtap="switchMode" data-mode="delete">
      <text class="action-icon">🗑️</text>
      <text class="action-text">删除</text>
    </view>
    <view class="action-btn {{autoRemind ? 'active' : ''}}" bindtap="toggleAutoRemind">
      <text class="action-icon">🔔</text>
      <text class="action-text">自动提醒</text>
    </view>
  </view>

  <!-- 提醒列表 -->
  <view class="group">
    <text class="group-title">📋 提醒列表</text>

    <view wx:for="{{templates}}" wx:key="id"
          class="row {{mode === 'delete' ? 'row-selectable' : ''}}"
          bindtap="tapTemplate" data-id="{{item.id}}">

      <!-- 删除模式：勾选框 -->
      <view wx:if="{{mode === 'delete'}}" class="checkbox-wrap">
        <view class="checkbox {{selectedMap[item.id] ? 'checked' : ''}}">
          <text wx:if="{{selectedMap[item.id]}}" class="check-mark">✓</text>
        </view>
      </view>

      <text class="row-icon">{{item.icon || '⏰'}}</text>
      <view class="row-main">
        <text class="row-label">{{item.title}}</text>
        <text class="row-sub">{{item.time}}{{item.note ? ' · ' + item.note : ''}}</text>
      </view>

      <!-- 自动生成标记 -->
      <view wx:if="{{item.autoGenerated}}" class="auto-badge">自动</view>

      <!-- 编辑模式图标 / 普通箭头 -->
      <text wx:if="{{mode === 'edit'}}" class="row-edit-icon">✏️</text>
      <text wx:elif="{{mode !== 'delete'}}" class="row-arrow">›</text>
    </view>

    <view wx:if="{{templates.length === 0}}" class="empty">暂无提醒事项</view>

    <view class="row add-row" bindtap="addTemplate">
      <text class="row-icon add-icon">＋</text>
      <text class="row-label-green">添加提醒</text>
    </view>
  </view>

  <!-- 删除模式底栏 -->
  <view wx:if="{{mode === 'delete'}}" class="delete-bar">
    <view class="delete-bar-left" bindtap="toggleSelectAll">
      <view class="checkbox {{selectAll ? 'checked' : ''}}">
        <text wx:if="{{selectAll}}" class="check-mark">✓</text>
      </view>
      <text class="delete-bar-label">全选</text>
    </view>
    <text class="delete-bar-count">已选 {{selectedCount}} 项</text>
    <view class="delete-bar-btn {{selectedCount > 0 ? '' : 'disabled'}}" bindtap="confirmDelete">
      <text class="delete-bar-btn-text">删除</text>
    </view>
  </view>

  <!-- 今日预览 -->
  <view class="group group-gap-top">
    <text class="group-title">🗓️ 今日预览</text>
    <view wx:for="{{today}}" wx:key="id" class="row">
      <text class="row-icon">{{item.icon || '⏰'}}</text>
      <view class="row-main">
        <text class="row-label">{{item.title}}</text>
        <text class="row-sub">{{item.time}}{{item.note ? ' · ' + item.note : ''}}</text>
      </view>
      <view class="status {{item.reminded ? 'done' : 'pending'}}"
            bindtap="toggleTodayStatus"
            data-tid="{{item.templateId}}"
            data-done="{{item.reminded}}">
        {{item.reminded ? '已提醒' : '未提醒'}}
      </view>
    </view>
    <view wx:if="{{today.length === 0}}" class="empty">今日无提醒事项</view>
  </view>

</view>
