.container { background: transparent; min-height: 100vh; padding-bottom: 200rpx; }

/* 页面标题 */
.page-header { padding: 48rpx 36rpx 28rpx; }
.page-title { display: block; font-size: 40rpx; font-weight: 800; color: #0d2b1f; }
.page-subtitle { display: block; font-size: 24rpx; color: #4a6355; margin-top: 10rpx; }

/* 操作栏 */
.action-bar {
  display: flex;
  margin: 0 36rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(47,133,90,0.08);
}
.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  transition: background 0.2s;
}
.action-btn.active { background: rgba(34,118,77,0.1); }
.action-btn.active .action-text { color: #1a6b42; font-weight: 700; }
.action-icon { font-size: 40rpx; }
.action-text { font-size: 22rpx; color: #4a6355; margin-top: 8rpx; }

/* 分组卡片 */
.group {
  margin: 0 36rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(47,133,90,0.08);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(47,133,90,0.08);
}
.group-title {
  display: block;
  padding: 28rpx 28rpx 12rpx;
  font-size: 24rpx;
  color: #6b8577;
  letter-spacing: 3rpx;
  font-weight: 700;
}

/* 列表行 */
.row {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-top: 1rpx solid rgba(47,133,90,0.06);
}
.row:first-of-type { border-top: none; }
.row-selectable { background: rgba(255,92,92,0.02); }
.row-icon { font-size: 42rpx; margin-right: 22rpx; flex-shrink: 0; }
.row-main { flex: 1; min-width: 0; }
.row-label {
  display: block;
  font-size: 30rpx;
  color: #0d2b1f;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row-sub {
  display: block;
  font-size: 24rpx;
  color: #4a6355;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row-arrow { font-size: 36rpx; color: #8a9e92; flex-shrink: 0; }
.row-edit-icon { font-size: 32rpx; flex-shrink: 0; }

/* 添加行 */
.add-row { background: rgba(34,118,77,0.04); }
.add-icon { color: #1a6b42; }
.row-label-green { font-size: 30rpx; color: #1a6b42; font-weight: 700; }

/* 自动标记 */
.auto-badge {
  font-size: 20rpx;
  color: #1a6b42;
  background: rgba(34,118,77,0.1);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

/* 勾选框 */
.checkbox-wrap { margin-right: 16rpx; flex-shrink: 0; }
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #8a9e92;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.checkbox.checked { background: #1a6b42; border-color: #1a6b42; }
.check-mark { color: #fff; font-size: 24rpx; font-weight: 700; }

/* 删除底栏 */
.delete-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 24rpx 36rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(47,133,90,0.1);
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
  z-index: 100;
}
.delete-bar-left { display: flex; align-items: center; }
.delete-bar-label { font-size: 28rpx; color: #0d2b1f; margin-left: 12rpx; }
.delete-bar-count { flex: 1; text-align: center; font-size: 26rpx; color: #6b8577; }
.delete-bar-btn {
  background: #ff5c5c;
  padding: 16rpx 40rpx;
  border-radius: 12rpx;
}
.delete-bar-btn.disabled { opacity: 0.4; }
.delete-bar-btn-text { color: #fff; font-size: 28rpx; font-weight: 700; }

/* 状态标签（可点击） */
.status {
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.status.done { color: #1a6b42; background: rgba(34,118,77,0.1); }
.status.pending { color: #e6a23c; background: rgba(230,162,60,0.1); }

/* 空状态 */
.empty { text-align: center; padding: 32rpx; color: #6b8577; font-size: 26rpx; }
