/* pages/dialect/dialect.wxss */
/* 兜底：确保页面底部空白区域也使用全局淡绿背景 */
page { background: var(--app-bg); }
/* 底部仅 tab-bar-spacer，避免与 padding-bottom 叠加双倍留白 */
.container { background: var(--app-bg); min-height: 100vh; padding-bottom: 0; }

/* 统一：页面标题（与全站一致的文字层级） */
.page-header { padding: 48rpx 36rpx 28rpx; }
.page-title { display: block; font-size: 40rpx; font-weight: 900; color: var(--pine-dark); letter-spacing: 1rpx; }
.page-subtitle { display: block; font-size: 26rpx; color: var(--text-muted); margin-top: 10rpx; line-height: 1.6; }

/* ── 翻译方向控制栏 ─────────────────────────── */
.control-bar {
  display: flex;
  align-items: center;
  margin: 0 36rpx 28rpx;
  gap: 0;
  flex-wrap: nowrap;
  position: relative;
  background: rgba(255,255,255,0.94);
  border: 1rpx solid rgba(47,133,90,0.10);
  border-radius: 28rpx;
  overflow: visible; /* 让中间交换按钮浮在上面 */
  box-shadow: 0 10rpx 26rpx rgba(44, 61, 53, 0.08);
}
.lang-box {
  flex: 1;
  background: transparent;
  border: none;
  border-radius: 28rpx;
  padding: 22rpx 22rpx;
  min-height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: none;
}
.lang-box-right {
  border-left: 1rpx solid rgba(47,133,90,0.10);
}
.lang-label  { 
  font-size: 30rpx; 
  font-weight: 800; 
  color: var(--pine-dark); 
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 220rpx;
  text-align: center; 
}
.lang-change { font-size: 22rpx; color: rgba(44, 61, 53, 0.60); font-weight: 600; }
.lang-change-sm { font-size: 18rpx; }
.swap-btn {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 84rpx;
  height: 84rpx;
  background: linear-gradient(135deg, var(--pine-dark), var(--pine-light));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 14rpx 30rpx rgba(61, 107, 87, 0.28);
  border-radius: 50%;
  border: 6rpx solid rgba(245, 251, 247, 0.92); /* 与页面淡绿背景融合 */
}
.swap-btn:active { opacity: var(--press-opacity); transform: translate(-50%, -50%) scale(var(--press-scale)); }
.swap-icon { font-size: 36rpx; color: #ffffff; font-weight: 700; }

/* ── 新增：方言选择下拉弹窗样式（适配多方言选项） ─────────── */
.lang-select-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.lang-select-content {
  background: rgba(255,255,255,0.96);
  border-radius: var(--radius);
  width: 80%;
  max-height: 60vh;
  overflow-y: auto; /* 新增：多选项时滚动 */
  padding: 20rpx 0;
  box-shadow: var(--shadow-float);
}
.lang-option {
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: var(--text);
  border-bottom: 1rpx solid var(--glass-border);
}
.lang-option.active {
  color: var(--pine-dark);
  font-weight: 700;
  background: rgba(61, 107, 87, 0.06);
}
.lang-option:last-child {
  border-bottom: none;
}

/* ── 输入卡片 ───────────────────────────────── */
.input-card { 
  margin: 0 36rpx 24rpx;
  background: rgba(255,255,255,0.96);
  padding: 30rpx;
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--pine-border);
}
.card {
  background: rgba(255,255,255,0.96);
  padding: 30rpx;
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
  border: 1rpx solid var(--pine-border);
}
.card-title { font-size: 28rpx; font-weight: 600; color: var(--text); display: block; margin-bottom: 20rpx; }
.card-title-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.link-text  { font-size: 24rpx; color: var(--pine); font-weight: 700; }

.text-area {
  width: 100%;
  min-height: 160rpx;
  background: rgba(44, 61, 53, 0.04);
  border: 1rpx solid var(--pine-border-12);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  font-size: 30rpx;
  color: var(--text);
  line-height: 1.6;
  box-sizing: border-box;
}
.ph { color: var(--text-faint); }
.char-count { text-align: right; font-size: 20rpx; color: var(--text-faint); margin-top: 8rpx; }

/* 与 control-bar / input-card 同列宽、同圆角与阴影，避免贴边直角条 */
button.test-upload-btn {
  margin: 0 36rpx 24rpx;
  width: calc(100% - 72rpx);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: var(--radius);
  overflow: hidden;
  background: rgba(255, 255, 255, 0.96) !important;
  border: 1rpx solid var(--pine-border) !important;
  color: var(--pine-dark) !important;
  box-shadow: var(--shadow-card);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  line-height: 1;
  white-space: nowrap;
  text-overflow: ellipsis;
}
button.test-upload-btn::after { border: none; }
button.test-upload-btn:active { transform: scale(var(--press-scale)); opacity: var(--press-opacity); }

/* 按钮样式补充 */
.btn {
  padding: 20rpx 0;
  border-radius: var(--radius-sm);
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  min-height: 88rpx;
}
.btn-ghost {
  background: rgba(44, 61, 53, 0.04);
  color: var(--pine-dark);
  border: 1rpx solid var(--pine-border-12);
}
.btn-primary {
  background: var(--pine-pale);
  border: 1rpx solid var(--pine-pale-12);
  color: var(--pine);
  font-weight: 800;
}
.btn-half   { flex: 1; }
.disabled   { opacity: 0.5; pointer-events: none; }

.action-row { display: flex; gap: 20rpx; margin-top: 24rpx; }

/* ── 语音输入按鈕 ───────────────────────────── */
.voice-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.96);
  border: 2rpx dashed rgba(61, 107, 87, 0.24);
  border-radius: var(--radius);
  padding: 40rpx 20rpx;
  margin-bottom: 24rpx;
  gap: 14rpx;
  transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
  box-shadow: var(--shadow-soft);
}
.voice-btn:active { transform: scale(var(--press-scale)); opacity: var(--press-opacity); }
.voice-recording {
  background: var(--red-pale);
  border-color: var(--red);
  border-style: solid;
}
.voice-icon  { font-size: 72rpx; line-height: 1; }
.voice-label { font-size: 32rpx; font-weight: 700; color: var(--text); }
.voice-hint  { font-size: 22rpx; color: var(--text-dim); }

/* ── 翻译结果 ──────────────────────────────── */
.result-card { 
  margin: 0 36rpx 24rpx; 
  border-left: 6rpx solid var(--teal);
  background: rgba(255,255,255,0.96);
  padding: 30rpx;
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--pine-border);
}
.result-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.result-title { font-size: 28rpx; font-weight: 600; color: var(--text); }
.replay-btn {
  font-size: 24rpx; color: var(--teal);
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(47,158,132,0.18);
  border-radius: 40rpx;
  background: var(--teal-pale);
}
.replay-btn:active { opacity: var(--press-opacity); transform: scale(var(--press-scale)); }
.result-text { font-size: 34rpx; color: var(--text); line-height: 1.7; display: block; font-weight: 500; }
.phonetic    { margin-top: 16rpx; }
.phonetic-label { font-size: 22rpx; color: var(--text-dim); }
.phonetic-text  { font-size: 22rpx; color: var(--amber); }

/* ── 分区标题 ───────────────────────────────── */
.section-title {
  font-size: 24rpx; color: var(--text-muted);
  letter-spacing: 3rpx; padding: 8rpx 40rpx 16rpx;
  font-weight: 700;
}

/* ── 常用短语 ───────────────────────────────── */
.phrase-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 36rpx 28rpx;
}
.phrase-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255,255,255,0.92);
  border: 1rpx solid var(--pine-border);
  border-radius: 999rpx;
  padding: 14rpx 26rpx;
  box-shadow: var(--shadow-soft);
}
.phrase-chip:active { transform: scale(var(--press-scale)); opacity: var(--press-opacity); }
.phrase-emoji { font-size: 28rpx; }
.phrase-text  { font-size: 24rpx; color: var(--text); }

/* ── 历史记录 ───────────────────────────────── */
.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--glass-border);
}
.history-item:last-child { border-bottom: none; }
.history-body     { flex: 1; }
.history-original { display: block; font-size: 26rpx; color: var(--text); }
.history-arrow    { display: block; font-size: 20rpx; color: var(--text-faint); margin-top: 4rpx; }
.history-result   { display: block; font-size: 22rpx; color: var(--teal); margin-top: 4rpx; }