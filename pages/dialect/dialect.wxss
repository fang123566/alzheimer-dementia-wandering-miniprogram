/* pages/dialect/dialect.wxss */
/* 全局变量定义（补充缺失的变量） */
:root {
  --radius: 16rpx;
  --radius-sm: 12rpx;
  --shadow-card: 0 4rpx 12rpx rgba(0,0,0,0.05);
  --text: #1e293b;
  --text-faint: #94a3b8;
  --text-dim: #64748b;
  --amber: #f59e0b;
  --teal: #14b8a6;
  --teal-pale: #e0f2f1;
  --red: #ef4444;
  --red-pale: #fee2e2;
  --glass-border: rgba(203, 213, 225, 0.5);
  --tab-bar-total-height: 100rpx;
}

.container { background: #f2f9f4; min-height: 100vh; padding-bottom: var(--tab-bar-total-height); }

/* ── 翻译方向控制栏 ─────────────────────────── */
.control-bar {
  display: flex;
  align-items: center;
  margin: 0 36rpx 28rpx;
  gap: 0;
  flex-wrap: nowrap; /* 新增：防止切换栏换行 */
}
.lang-box {
  flex: 1;
  background: #ffffff;
  border: 1rpx solid rgba(47,133,90,0.10);
  border-radius: var(--radius) 0 0 var(--radius);
  padding: 22rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  box-shadow: var(--shadow-card);
  /* 新增：限制最大宽度，防止撑爆 */
  max-width: 200rpx;
}
.lang-box-right {
  border-radius: 0 var(--radius) var(--radius) 0;
  border-left: none;
}
.lang-label  { 
  font-size: 28rpx; 
  font-weight: 700; 
  color: #1a6b42; 
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 160rpx;
  text-align: center; 
}
.lang-change { font-size: 20rpx; color: #6b8577; }
.swap-btn {
  width: 80rpx; height: 80rpx;
  background: linear-gradient(135deg, #22764d, #38a169);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(34,118,77,0.22);
  border-radius: 50%; /* 新增：改成圆形，视觉更友好 */
}
.swap-icon { font-size: 36rpx; color: #ffffff; font-weight: 700; }

/* ── 新增：方言选择下拉弹窗样式（适配多方言选项） ─────────── */
.lang-select-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.lang-select-content {
  background: #fff;
  border-radius: var(--radius);
  width: 80%;
  max-height: 60vh;
  overflow-y: auto; /* 新增：多选项时滚动 */
  padding: 20rpx 0;
}
.lang-option {
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: var(--text);
  border-bottom: 1rpx solid var(--glass-border);
}
.lang-option.active {
  color: #1a6b42;
  font-weight: 700;
  background: #f4f9f5;
}
.lang-option:last-child {
  border-bottom: none;
}

/* ── 输入卡片 ───────────────────────────────── */
.input-card { 
  margin: 0 36rpx 24rpx;
  background: #fff;
  padding: 30rpx;
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
}
.card {
  background: #fff;
  padding: 30rpx;
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
}
.card-title { font-size: 28rpx; font-weight: 600; color: var(--text); display: block; margin-bottom: 20rpx; }
.card-title-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.link-text  { font-size: 24rpx; color: var(--amber); }

.text-area {
  width: 100%;
  min-height: 160rpx;
  background: #f4f9f5;
  border: 1rpx solid rgba(47,133,90,0.10);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  font-size: 30rpx;
  color: var(--text);
  line-height: 1.6;
  box-sizing: border-box;
}
.ph { color: var(--text-faint); }
.char-count { text-align: right; font-size: 20rpx; color: var(--text-faint); margin-top: 8rpx; }

/* 按钮样式补充 */
.btn {
  padding: 20rpx 0;
  border-radius: var(--radius-sm);
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-ghost {
  background: #f4f9f5;
  color: #1a6b42;
  border: 1rpx solid rgba(47,133,90,0.10);
}
.btn-primary {
  background: linear-gradient(135deg, #22764d, #38a169);
  color: #fff;
}
.btn-half   { flex: 1; }
.disabled   { opacity: 0.5; pointer-events: none; }

.action-row { display: flex; gap: 20rpx; margin-top: 24rpx; }

/* ── 语音输入按鈕 ───────────────────────────── */
.voice-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 2rpx dashed rgba(47,133,90,0.18);
  border-radius: var(--radius);
  padding: 40rpx 20rpx;
  margin-bottom: 24rpx;
  gap: 14rpx;
  transition: all 0.2s;
  box-shadow: var(--shadow-card);
}
.voice-recording {
  background: var(--red-pale);
  border-color: var(--red);
  border-style: solid;
}
.voice-icon  { font-size: 72rpx; line-height: 1; }
.voice-label { font-size: 32rpx; font-weight: 700; color: var(--text); }
.voice-hint  { font-size: 22rpx; color: var(--text-dim); }

/* ── 翻译结果 ──────────────────────────────── */
.result-card { 
  margin: 0 36rpx 24rpx; 
  border-left: 6rpx solid var(--teal);
  background: #fff;
  padding: 30rpx;
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
}
.result-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.result-title { font-size: 28rpx; font-weight: 600; color: var(--text); }
.replay-btn {
  font-size: 24rpx; color: var(--teal);
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(62,207,207,0.3);
  border-radius: 40rpx;
  background: var(--teal-pale);
}
.result-text { font-size: 34rpx; color: var(--text); line-height: 1.7; display: block; font-weight: 500; }
.phonetic    { margin-top: 16rpx; }
.phonetic-label { font-size: 22rpx; color: var(--text-dim); }
.phonetic-text  { font-size: 22rpx; color: var(--amber); }

/* ── 分区标题 ───────────────────────────────── */
.section-title {
  font-size: 24rpx; color: #6b8577;
  letter-spacing: 3rpx; padding: 8rpx 40rpx 16rpx;
  font-weight: 700;
}

/* ── 常用短语 ───────────────────────────────── */
.phrase-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 36rpx 28rpx;
}
.phrase-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #ffffff;
  border: 1rpx solid rgba(47,133,90,0.08);
  border-radius: 999rpx;
  padding: 14rpx 26rpx;
  box-shadow: var(--shadow-card);
}
.phrase-emoji { font-size: 28rpx; }
.phrase-text  { font-size: 24rpx; color: var(--text); }

/* ── 历史记录 ───────────────────────────────── */
.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--glass-border);
}
.history-item:last-child { border-bottom: none; }
.history-body     { flex: 1; }
.history-original { display: block; font-size: 26rpx; color: var(--text); }
.history-arrow    { display: block; font-size: 20rpx; color: var(--text-faint); margin-top: 4rpx; }
.history-result   { display: block; font-size: 22rpx; color: var(--teal); margin-top: 4rpx; }