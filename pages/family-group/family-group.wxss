/* pages/family-group/family-group.wxss */

.container { background: transparent; min-height: 100vh; padding-bottom: 60rpx; }

/* 页面标题 */
.page-header {
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 36rpx 32rpx; text-align: center;
}
.page-header-icon { font-size: 64rpx; margin-bottom: 12rpx; }
.page-header-title { font-size: 40rpx; font-weight: 900; color: var(--pine-ink); }
.page-header-sub { font-size: 26rpx; color: var(--text-muted); margin-top: 8rpx; }

/* 邀请按钮 */
.invite-btn {
  display: flex; align-items: center; gap: 22rpx;
  margin: 0 36rpx 32rpx; padding: 32rpx 28rpx;
  background: linear-gradient(135deg, rgba(61,107,87,0.08), rgba(61,107,87,0.02));
  border: 2rpx dashed rgba(61,107,87,0.32);
  border-radius: 20rpx;
}
.invite-btn:active { opacity: 0.85; }
.invite-icon-wrap {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: var(--pine); display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; box-shadow: 0 4rpx 12rpx rgba(56,161,105,0.3);
}
.invite-icon { font-size: 40rpx; color: #fff; font-weight: 700; line-height: 1; }
.invite-text-wrap { flex: 1; }
.invite-title { display: block; font-size: 32rpx; font-weight: 800; color: var(--pine-dark); }
.invite-sub { display: block; font-size: 24rpx; color: var(--text-muted); margin-top: 6rpx; }

/* 成员区域 */
.member-section {
  margin: 0 36rpx; background: rgba(255,255,255,0.96);
  border-radius: 20rpx; border: 1rpx solid var(--pine-border);
  overflow: hidden; box-shadow: var(--shadow-card);
}
.member-section-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx; border-bottom: 1rpx solid rgba(47,133,90,0.06);
}
.member-section-title { font-size: 30rpx; font-weight: 900; color: var(--pine-ink); }
.member-section-count {
  font-size: 24rpx; color: #38a169; font-weight: 600;
  background: #e6f9ee; padding: 6rpx 18rpx; border-radius: 999rpx;
}

/* 空状态 */
.member-empty {
  display: flex; flex-direction: column; align-items: center;
  padding: 64rpx 0 56rpx; gap: 12rpx;
}
.member-empty-icon { font-size: 72rpx; opacity: 0.5; }
.member-empty-title { font-size: 30rpx; font-weight: 700; color: #6b8577; }
.member-empty-sub { font-size: 24rpx; color: #8a9e92; }
.member-empty-title { color: var(--text-muted); }

/* 成员卡片 */
.member-card {
  border-bottom: 1rpx solid rgba(47,133,90,0.06);
}
.member-card:last-child { border-bottom: none; }
.member-card-body {
  display: flex; align-items: center; padding: 28rpx 32rpx; gap: 20rpx;
}

/* 头像 */
.member-avatar-wrap {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: linear-gradient(135deg, #e6f9ee 0%, #d0ece3 100%);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; border: 2rpx solid rgba(56,161,105,0.15);
}
.member-avatar { font-size: 44rpx; line-height: 1; }

/* 信息 */
.member-info { flex: 1; min-width: 0; }
.member-name-row { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; margin-bottom: 8rpx; }
.member-name { font-size: 32rpx; font-weight: 700; color: #0d2b1f; }
.member-role-tag {
  font-size: 22rpx; font-weight: 600;
  padding: 4rpx 16rpx; border-radius: 999rpx;
}
.role-admin {
  color: #d97706; background: #fef3c7; border: 1rpx solid rgba(217,119,6,0.15);
}
.role-normal {
  color: #38a169; background: #e6f9ee; border: 1rpx solid rgba(56,161,105,0.15);
}
.member-self-tag {
  font-size: 20rpx; color: #6366f1; font-weight: 700;
  background: #eef2ff; padding: 4rpx 14rpx; border-radius: 999rpx;
  border: 1rpx solid rgba(99,102,241,0.15);
}
.member-join-time { font-size: 24rpx; color: #8a9e92; }

/* 操作按钮 */
.member-action {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; background: rgba(255, 255, 255, 0.78);
}
.member-action:active { background: #e0efe4; }
.member-action-icon { font-size: 36rpx; color: #6b8577; font-weight: 700; }

/* ── 家属端解除绑定区域 ─────────────────────────────── */
.unbind-section {
  margin: 24rpx 32rpx;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid rgba(239, 68, 68, 0.15);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(239, 68, 68, 0.06);
}
.unbind-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  background: rgba(239, 68, 68, 0.08);
  border-radius: 999rpx;
}
.unbind-icon {
  font-size: 32rpx;
}
.unbind-text {
  font-size: 30rpx;
  color: #ef4444;
  font-weight: 600;
}
.unbind-hint {
  font-size: 24rpx;
  color: #8a9e92;
  text-align: center;
}

/* ── 邀请弹窗 ─────────────────── */
.qr-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 999;
  display: flex; align-items: center; justify-content: center;
}
.qr-modal {
  width: 620rpx; background: #fff; border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx; position: relative;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.15);
}
.qr-title {
  display: block; text-align: center;
  font-size: 36rpx; font-weight: 800; color: #0d2b1f;
}
.qr-sub {
  display: block; text-align: center;
  font-size: 26rpx; color: #6b8577; margin-top: 10rpx; line-height: 1.6;
}

/* 老人手机号展示 */
.invite-phone-wrap {
  margin: 28rpx 0 0;
  padding: 24rpx 28rpx;
  background: #f0faf4; border-radius: 16rpx;
  border: 1rpx solid rgba(56,161,105,0.15);
  text-align: center;
}
.invite-phone-label {
  display: block; font-size: 24rpx; color: #6b8577; margin-bottom: 10rpx;
}
.invite-phone-value {
  display: block; font-size: 40rpx; font-weight: 800; color: #38a169;
  letter-spacing: 6rpx;
}
.invite-phone-empty .invite-phone-label { color: #8a9e92; font-size: 26rpx; }

/* 步骤列表 */
.invite-steps { margin: 24rpx 0; display: flex; flex-direction: column; gap: 16rpx; }
.invite-step { display: flex; align-items: center; gap: 16rpx; }
.invite-step-num {
  width: 44rpx; height: 44rpx; border-radius: 50%; flex-shrink: 0;
  background: #38a169; color: #fff;
  font-size: 24rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
}
.invite-step-text { font-size: 26rpx; color: #3d5a4c; flex: 1; }

/* 操作按钮 */
.qr-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.qr-btn {
  flex: 1; padding: 24rpx 0; border-radius: 14rpx;
  text-align: center;
}
.qr-btn:active { opacity: 0.8; }
.qr-btn-copy {
  background: #f0faf4; border: 1rpx solid rgba(56,161,105,0.2);
}
.qr-btn-copy .qr-btn-text { font-size: 28rpx; font-weight: 700; color: #38a169; }
.qr-btn-share { background: #38a169; }
.qr-btn-share .qr-btn-text { font-size: 28rpx; font-weight: 700; color: #fff; }

/* 关闭按钮 */
.qr-close {
  position: absolute; top: 20rpx; right: 24rpx;
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: #f2f4f3;
}
.qr-close:active { background: #e0e5e2; }
.qr-close-icon { font-size: 28rpx; color: #6b8577; }
