<!-- pages/family-group/family-group.wxml -->
<view class="container">

  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-header-icon">👥</text>
    <text class="page-header-title">家庭组管理</text>
    <text class="page-header-sub">管理家庭成员，共同守护老人</text>
  </view>

  <!-- 邀请成员按钮 -->
  <view class="invite-btn" bindtap="inviteMember">
    <view class="invite-icon-wrap">
      <text class="invite-icon">+</text>
    </view>
    <view class="invite-text-wrap">
      <text class="invite-title">邀请家人加入</text>
      <text class="invite-sub">生成邀请二维码，扫码即可加入家庭组</text>
    </view>
  </view>

  <!-- 家属端：解除绑定按钮（有绑定关系时显示） -->
  <view class="unbind-section" wx:if="{{role === 'family' && canUnbind}}">
    <view class="unbind-btn" bindtap="handleUnbind">
      <text class="unbind-icon">🔗</text>
      <text class="unbind-text">解除与老人的绑定</text>
    </view>
    <text class="unbind-hint">解除后将无法查看该老人的位置和预警信息</text>
  </view>

  <!-- 成员列表 -->
  <view class="member-section">
    <view class="member-section-header">
      <text class="member-section-title">{{role === 'elderly' ? '成员列表' : '已绑定老人'}}</text>
      <text class="member-section-count">{{members.length}} 人</text>
    </view>

    <!-- 空状态 -->
    <view class="member-empty" wx:if="{{!members.length}}">
      <text class="member-empty-icon">👨‍👩‍👧‍👦</text>
      <text class="member-empty-title">暂无家庭成员</text>
      <text class="member-empty-sub">点击上方按钮邀请家人加入</text>
    </view>

    <!-- 成员卡片 -->
    <view wx:for="{{members}}" wx:key="id" class="member-card">
      <view class="member-card-body">
        <!-- 头像 -->
        <view class="member-avatar-wrap">
          <text class="member-avatar">{{item.avatar || '👤'}}</text>
        </view>
        <!-- 信息 -->
        <view class="member-info">
          <view class="member-name-row">
            <text class="member-name">{{item.name}}</text>
            <text class="member-role-tag {{item.role === 'admin' ? 'role-admin' : 'role-normal'}}">{{item.role === 'admin' ? '管理员' : '普通成员'}}</text>
            <text class="member-self-tag" wx:if="{{item.isSelf}}">我</text>
          </view>
          <text class="member-join-time">{{item.joinTime || '加入时间未知'}}</text>
        </view>
        <!-- 操作按钮：老人端管理员可见 / 家属端可见 -->
        <view class="member-action" wx:if="{{(isAdmin && !item.isSelf) || (role === 'family' && item.role === 'elderly')}}" catchtap="onMemberAction" data-id="{{item.id}}" data-name="{{item.name}}" data-role="{{item.role}}">
          <text class="member-action-icon">⋯</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 邀请家人弹窗 -->
  <view class="qr-mask" wx:if="{{showInviteModal}}" bindtap="closeInviteModal">
    <view class="qr-modal" catchtap="">
      <text class="qr-title">邀请家人加入</text>
      <text class="qr-sub">让家人注册后，在「账号绑定」页输入老人手机号即可加入</text>

      <view class="invite-phone-wrap" wx:if="{{elderlyPhone}}">
        <text class="invite-phone-label">老人手机号</text>
        <text class="invite-phone-value">{{elderlyPhone}}</text>
      </view>
      <view class="invite-phone-wrap invite-phone-empty" wx:else>
        <text class="invite-phone-label">绑定老人后可查看手机号</text>
      </view>

      <view class="invite-steps">
        <view class="invite-step">
          <text class="invite-step-num">1</text>
          <text class="invite-step-text">让家人下载并注册「守护·陪伴」</text>
        </view>
        <view class="invite-step">
          <text class="invite-step-num">2</text>
          <text class="invite-step-text">注册时选择「家属」角色</text>
        </view>
        <view class="invite-step">
          <text class="invite-step-num">3</text>
          <text class="invite-step-text">在「账号绑定」页输入老人手机号</text>
        </view>
      </view>

      <view class="qr-actions">
        <view class="qr-btn qr-btn-copy" bindtap="copyElderlyPhone" wx:if="{{elderlyPhone}}">
          <text class="qr-btn-text">复制手机号</text>
        </view>
        <view class="qr-btn qr-btn-share" bindtap="shareInvite">
          <text class="qr-btn-text">分享小程序</text>
        </view>
      </view>
      <view class="qr-close" bindtap="closeInviteModal">
        <text class="qr-close-icon">✕</text>
      </view>
    </view>
  </view>

</view>
