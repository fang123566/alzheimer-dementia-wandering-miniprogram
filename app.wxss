/* app.wxss - 全局样式 */

/* ── 设计变量 ─────────────────────────────── */
page {
  --tab-bar-height: 120rpx;
  --tab-bar-safe: env(safe-area-inset-bottom);
  --tab-bar-total-height: calc(var(--tab-bar-height) + var(--tab-bar-safe));
  /* 全站统一背景（与注册/登录页一致的淡绿色） */
  --app-bg: linear-gradient(180deg, #f5fbf7 0%, #eef7f1 38%, #e7f2eb 100%);
  /* 常青树 · 松绿色系（新中式首页主色，全站可复用） */
  --pine:           #3d6b57;
  --pine-light:     #5a8f78;
  --pine-soft:      #4a7c68;
  --pine-dark:      #2a4a3c;
  --pine-ink:       #2c3d35;
  --pine-pale:      rgba(61, 107, 87, 0.10);
  --pine-pale-12:   rgba(61, 107, 87, 0.12);
  --pine-pale-18:   rgba(61, 107, 87, 0.18);
  --pine-14:        rgba(61, 107, 87, 0.14);
  --pine-20:        rgba(61, 107, 87, 0.20);
  --pine-22:        rgba(61, 107, 87, 0.22);
  --pine-25:        rgba(61, 107, 87, 0.25);
  --pine-alpha-65:  rgba(61, 107, 87, 0.65);
  --pine-border:    rgba(61, 107, 87, 0.10);
  --pine-border-12: rgba(61, 107, 87, 0.12);
  --pine-shadow:    rgba(44, 61, 53, 0.08);
  --text-muted:     #6b7d74;
  --cream:          #faf8f4;
  --cream-mist:     #f0ebe3;
  --gray-mist:      #ebe6de;
  --gold:           #c9a962;
  --gold-pale:      rgba(201, 169, 98, 0.22);
  --gold-soft:      #e8d5a3;
  --warm-amber:     #d4a574;
  --warm-coral:     #e59866;

  --ink:        #f4fbf6;
  --ink-2:      #ffffff;
  --ink-3:      #e8f5ec;
  /* 语义色与松绿对齐，避免各页色相不统一 */
  --amber:      var(--warm-amber);
  --amber-light:#38a169;
  --amber-pale: rgba(212, 165, 116, 0.20);
  --teal:       #2f9e84;
  --teal-pale:  rgba(47,158,132,0.12);
  --red:        #ef4444;
  --red-pale:   rgba(239,68,68,0.10);
  --green:      var(--pine);
  --green-pale: var(--pine-pale);
  --glass:      rgba(255,255,255,0.96);
  --glass-border: var(--pine-border-12);
  --text:       var(--pine-ink);
  --text-dim:   rgba(44, 61, 53, 0.78);
  --text-faint: rgba(44, 61, 53, 0.52);
  --radius:     28rpx;
  --radius-sm:  18rpx;
  --radius-lg:  36rpx;
  --shadow-card: 0 8rpx 32rpx var(--pine-shadow), 0 2rpx 8rpx rgba(44, 61, 53, 0.04);
  --shadow-float: 0 16rpx 48rpx rgba(44, 61, 53, 0.10), 0 4rpx 12rpx rgba(44, 61, 53, 0.06);
  --shadow-soft: 0 6rpx 18rpx rgba(44, 61, 53, 0.06);

  /* 统一间距刻度（页面间更一致） */
  --space-1: 8rpx;
  --space-2: 12rpx;
  --space-3: 16rpx;
  --space-4: 20rpx;
  --space-5: 24rpx;
  --space-6: 28rpx;
  --space-7: 32rpx;
  --space-8: 36rpx;
  --space-9: 40rpx;

  /* 统一可点按反馈 */
  --press-scale: 0.98;
  --press-opacity: 0.92;

  /* 老人模式大字号变量 */
  --font-base:     28rpx;
  --font-lg:       32rpx;
  --font-xl:       36rpx;
  --font-xxl:      44rpx;

  /* 首页等区域可用的标题阶梯（默认） */
  --home-banner-title:   40rpx;
  --home-banner-sub:     28rpx;
  --home-nav-text:       28rpx;
  --home-search-text:    30rpx;
  --home-section-title:  34rpx;
  --home-func-label:     26rpx;
  --home-func-glyph:     44rpx;
  --home-card-title:     30rpx;
  --home-stat-label:     22rpx;
  --home-stat-value:     28rpx;
  --home-sos-label:      48rpx;
  --home-sos-hint:       26rpx;
  --home-e-loc-addr:     30rpx;
  --home-e-device:       28rpx;

  background: var(--app-bg);
  color: var(--text);
  font-family: -apple-system, 'PingFang SC', 'Noto Sans SC', sans-serif;
  font-size: var(--font-base);
}

/* 老人模式 - 大字号 */
page.elderly-mode {
  --font-base:     36rpx;
  --font-lg:       44rpx;
  --font-xl:       52rpx;
  --font-xxl:      64rpx;
  --home-banner-title:   52rpx;
  --home-banner-sub:     34rpx;
  --home-nav-text:       32rpx;
  --home-search-text:    32rpx;
  --home-section-title:  38rpx;
  --home-func-label:     30rpx;
  --home-func-glyph:     48rpx;
  --home-card-title:     34rpx;
  --home-stat-label:     26rpx;
  --home-stat-value:     32rpx;
  --home-sos-label:      56rpx;
  --home-sos-hint:       30rpx;
  --home-e-loc-addr:     34rpx;
  --home-e-device:       32rpx;
}

/* ── 通用卡片 ─────────────────────────────── */
.card {
  background: var(--glass);
  border: 1rpx solid var(--pine-border);
  border-radius: var(--radius);
  padding: 36rpx;
  margin-bottom: 28rpx;
  box-shadow: var(--shadow-card);
}
.card-soft {
  background: rgba(255, 255, 255, 0.86);
  box-shadow: var(--shadow-soft);
}
.card:active {
  opacity: var(--press-opacity);
}

/* ── 状态标签 ─────────────────────────────── */
.tag {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  backdrop-filter: blur(8rpx);
}
.tag-safe     { background: var(--green-pale);  color: var(--green); }
.tag-warning  { background: var(--amber-pale);  color: var(--amber); }
.tag-danger   { background: var(--red-pale);    color: var(--red);   }
.tag-teal     { background: var(--teal-pale);   color: var(--teal);  }

/* ── 按钮 ─────────────────────────────────── */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius);
  font-size: 30rpx;
  font-weight: 700;
  padding: 26rpx 0;
  letter-spacing: 1rpx;
  min-height: 88rpx;
  transition: transform 0.18s ease, opacity 0.18s ease, background-color 0.18s ease, border-color 0.18s ease;
}
.btn-primary  { background: linear-gradient(135deg, var(--pine-dark) 0%, var(--pine-light) 100%);  color: #ffffff; box-shadow: 0 12rpx 28rpx var(--pine-pale-18); }
.btn-danger   { background: linear-gradient(135deg, #ef4444, #f87171);  color: #fff; box-shadow: 0 10rpx 24rpx rgba(239,68,68,0.18); }
.btn-ghost    { background: #ffffff;  color: var(--pine-ink); border: 1rpx solid var(--pine-border-12); box-shadow: var(--shadow-card); }
.btn:active {
  transform: scale(var(--press-scale));
  opacity: var(--press-opacity);
}
.btn-ghost:active {
  background: rgba(255, 255, 255, 0.92);
}

/* ── 页面头部 ────────────────────────────── */
.page-header {
  padding: 48rpx 36rpx 32rpx;
}
.page-title {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--pine-dark);
  letter-spacing: 2rpx;
  display: block;
}
.page-subtitle {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-top: 12rpx;
  letter-spacing: 1rpx;
  display: block;
  line-height: 1.6;
}

/* ── 分割线 ──────────────────────────────── */
.divider {
  height: 1rpx;
  background: var(--glass-border);
  margin: 16rpx 0;
}

/* ── 列表行 ──────────────────────────────── */
.list-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--glass-border);
}
.list-row:last-child { border-bottom: none; }
.list-row:active {
  opacity: var(--press-opacity);
}

/* ── 角色切换条 ──────────────────────────── */
.role-bar {
  display: flex;
  background: #ffffff;
  border: 1rpx solid var(--pine-border);
  border-radius: var(--radius);
  padding: 8rpx;
  margin: 24rpx 36rpx;
  box-shadow: var(--shadow-card);
}
.role-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--text-muted);
  font-weight: 500;
  transition: background-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
}
.role-btn.active {
  background: linear-gradient(135deg, var(--pine-dark) 0%, var(--pine-light) 100%);
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx var(--pine-pale-18);
}

/* ── 底部导航栏占位块（tabBar 页面 wxml 末尾加此块即可） ──
 * 勿与页面根节点上 padding-bottom: var(--tab-bar-total-height) 同时使用，否则会双倍留白。 */
.tab-bar-spacer {
  height: var(--tab-bar-total-height);
  flex-shrink: 0;
}

/* 统一页面容器背景，避免各页写死底色覆盖全局背景 */
.container,
.page-container {
  background: transparent;
}
